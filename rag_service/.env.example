# mimoTalk API Key (primary LLM — required for report generation)
MIMOTALK_API_KEY=your-mimotalk-api-key-here
MIMOTALK_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic/v1
MIMOTALK_MODEL=mimo-v2.5

# ModelScope API Key (embedding fallback — Qwen3-Embedding-0.6B via API)
MODELSCOPE_API_KEY=your-modelscope-api-key-here

# Ollama (local embedding — run: ollama pull nomic-embed-text)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Demo mode (disable real API calls for local testing)
DEMO_MODE=false
