# mimoTalk API key (primary LLM API, required outside demo mode)
MIMOTALK_API_KEY=your-mimotalk-api-key-here
MIMOTALK_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic/v1
MIMOTALK_MODEL=mimo-v2.5

# ModelScope API key (embedding API, required outside demo mode)
MODELSCOPE_API_KEY=your-modelscope-api-key-here

# Demo mode disables real API calls for local testing
DEMO_MODE=false
