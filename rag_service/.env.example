# Demo mode disables real API calls for local testing
DEMO_MODE=false

# ── LLM（唯一外部 API；Anthropic 兼容端点） ────────────────────────────────
# 生产必需（非 demo）。MINIMAX_* 是规范名；MIMOTALK_* 是兼容别名（仅当
# MINIMAX 未设置时生效，见 config.py resolve_minimax_config）。
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
MINIMAX_MODEL=MiniMax-M3

# ── 视觉降级通道（2026-09-16，OpenAI 兼容）────────────────────────────────
# MiniMax 视觉端点偶发不可用时，同一张图的观察请求降级到此端点，避免整条
# 扫描在第一步就丢掉视觉证据。留空 = 关闭降级。只服务识图，不接管报告生成。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Anthropic-compatible endpoint — report generation. The code appends
# '/messages', so the '/v1' segment is required.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic/v1

# ── 服务间认证（生产 fail-closed） ──────────────────────────────────────────
# BFF ↔ RAG 内部密钥；生产留空直接拒绝启动。≥32 字符。
RAG_INTERNAL_SECRET=

# ── De-RAG 管线 ─────────────────────────────────────────────────────────────
# 生产路径：图片扫描（无用户上传文档）时用捆绑法规库构建 LLM 上下文。
USE_KB_INPUT=true

# 可选调优：扫描并发 worker 数（默认 5）
# SCAN_WORKER_CONCURRENCY=5

# 发布标识（部署脚本写入；/ready 与审计日志读取）
# ATTRAX_BUILD_SHA=
