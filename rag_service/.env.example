# Provider-neutral LLM config (required outside demo mode).
# MiniMax production example; local development can point these variables at
# any Anthropic-compatible provider such as Alibaba Model Studio.
LLM_PROVIDER=minimax
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://api.minimaxi.com/anthropic/v1
LLM_MODEL=MiniMax-M3
# Optional: enabled or disabled. Empty preserves the provider default.
LLM_THINKING=
# Max-quality models can need more than 90 seconds for a full report package.
LLM_TIMEOUT_SECONDS=240

# MINIMAX_* and MIMOTALK_* remain accepted as compatibility aliases.

# Demo mode disables real API calls for local testing
DEMO_MODE=false

# De-RAG production path: build LLM context from the bundled regulation
# library when scans contain images but no user-uploaded regulation document.
USE_KB_INPUT=true
