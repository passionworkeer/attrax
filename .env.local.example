# LLM provider (Anthropic-compatible endpoint).
# MINIMAX_* and MIMOTALK_* remain accepted as compatibility aliases.
LLM_PROVIDER=minimax
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.minimaxi.com/anthropic/v1
LLM_MODEL=MiniMax-M3
LLM_THINKING=

# Vision FALLBACK provider (2026-09-16). MiniMax is primary; when its call
# fails the same image request degrades to this OpenAI-compatible endpoint
# instead of losing the scan's visual evidence. Leave the key blank to keep
# the fallback disabled. Vision only — the report writer stays on MiniMax.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Anthropic-compatible endpoint — report generation. The code appends
# '/messages', so the '/v1' segment is required.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic/v1

# ModelScope API embedding
MODELSCOPE_API_KEY=your_modelscope_api_key

DAILY_FREE_SCAN_LIMIT=3

DEMO_MODE=false

# RAG Service backend URL (default: port 8001)
RAG_SERVICE_URL=http://localhost:8001

# Standalone FastAPI runtime state (sessions, jobs, uploads, audit log).
ATTRAX_RUNTIME_DIR=./data/backend

# CORS: comma-separated allowed origins for the RAG service.
# Required for cross-origin browser calls if frontend and RAG are on different
# domains. Local defaults allow localhost:3000; production deployment
# preflight requires this value explicitly and rejects wildcard origins.
# Production value (2026-06-21): https://twinbuddy.xyz
RAG_ALLOWED_ORIGINS=https://yourdomain.com

# Ops: webhook called by scripts/uptime-alert.sh when /api/health fails.
# Supports any service that accepts POST JSON (DingTalk, WeChat Work,
# Slack incoming webhook, PagerDuty Events API). Leave unset to log only.
# Example: https://oapi.dingtalk.com/robot/send?access_token=XXX
# UPTIME_WEBHOOK_URL=

# Ops: rsync destination for scripts/backup-remote.sh (daily 04:00 cron).
# Examples: user@backup-host:/srv/attrax-backups
#           s3://my-bucket/attrax-backups (requires aws-cli configured)
# Leave unset to skip remote sync (local backups still run at 03:00).
# BACKUP_REMOTE_DEST=
