# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
test-results/
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# ─── 临时文件 ──────────────────────────────────────────────────
npm.log
npm-debug.log*
test_scan.json
lib/i18n-server.ts
docs/competitions/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
.env.local

# vercel
.vercel

# runtime uploads
public/uploads/

# session persistence files (auto-generated at runtime)
data/sessions/

# test artifacts
test-doc-upload/

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── 合规语料库 ────────────────────────────────────────────────
# 源文件（PDF/DOCX/HTML）不纳入版本控制
data/全部法规/
data/合规/
data/corpus/eu/regulations/pdfs/
data/corpus/eu/regulations/html/
data/corpus/eu/products/
data/corpus/eu/uk/
data/corpus/us/
data/corpus/cn/
data/corpus/asia/
data/corpus/middle_east/
data/corpus/gcc/
data/corpus/intl/
data/corpus/reference/
data/corpus/screenshot_pending/

# processed JSON 由 build_corpus.py 生成，不纳入版本控制；
# Official supplement ingestions are curated corpus additions and may be reviewed.
data/corpus/processed/*
!data/corpus/processed/*_Official_*.json
data/corpus/manifest.json
data/corpus/corpus_index.json
data/corpus/quality_report.json

# analysis/ 是生成产物，不纳入版本控制
data/analysis/

# Faiss 索引（由 build_faiss.py 生成，存储于 ASCII 路径）
data/faiss/
data/faiss_versions/
C:/temp/faiss_index/

# 临时输出文件
integration_result.txt
check_result.txt

# scripts/ 调试脚本（不纳入版本控制）
scripts/debug_dense.py
scripts/test_retrieval_only.py

# 归档脚本（不纳入版本控制）
scripts/archive/

# deepeval 评估产物（不纳入版本控制）
.deepeval/

# ─── Python ──────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─── Docker ──────────────────────────────────────────────────
qdrant_storage/

# ─── Embedding cache ─────────────────────────────────────────
*.cache/
embedding_cache/

# ─── Local Claude/worktree artifacts ─────────────────────────
.claude/

# ─── Nested local repository copy ────────────────────────────
attrax/
