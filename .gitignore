npm.log
npm-debug.log*
test_scan.json
lib/i18n-server.ts
docs/competitions/
docs/evidence/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.production.example
.env.local

# vercel
.vercel

# runtime uploads
public/uploads/

# session persistence files (auto-generated at runtime)
data/sessions/
data/backend/

# per-session upload archive (legacy; the local upload-storage module was
# removed with the dead local session pipeline on 2026-09-14 — RAG service
# keeps its own uploads under data/backend/uploads/)
data/uploads/

# user activity log (auto-generated per request)
logs/user-activity.log

# test artifacts
test-doc-upload/

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── 合规语料库 ────────────────────────────────────────────────
# 源文件（PDF/DOCX/HTML）不纳入版本控制
data/全部法规/
data/合规/
data/corpus/eu/regulations/pdfs/
data/corpus/eu/regulations/html/
data/corpus/eu/products/
data/corpus/eu/uk/
data/corpus/us/
data/corpus/cn/
data/corpus/asia/
data/corpus/middle_east/
data/corpus/gcc/
data/corpus/intl/
data/corpus/reference/
data/corpus/screenshot_pending/

# processed JSON 由 build_corpus.py 生成，不纳入版本控制；
# Official supplement ingestions are curated corpus additions and may be reviewed.
data/corpus/processed/*
!data/corpus/processed/*_Official_*.json
data/corpus/manifest.json
data/corpus/corpus_index.json
data/corpus/quality_report.json

# 临时输出文件
integration_result.txt
check_result.txt
/export-*.zip

# scripts/ 调试脚本（不纳入版本控制）
scripts/debug_dense.py
scripts/test_retrieval_only.py

# 归档脚本（不纳入版本控制）
scripts/archive/

# deepeval 评估产物（不纳入版本控制）
.deepeval/

# RAG eval 运行产物（评测结果 JSON，由 run_eval.py 生成）
rag_service/eval/results/

# ─── regwatch/watchdog runtime outputs (PM2 cron writes) ────────
# 这些是 regwatch 守护进程（PM2 module）在 cron 周期写入的运行时
# 产物，不应纳入版本控制。注：data/corpus/ 与 data/regulations/ 下
# watchdog 会改写的 manifest / index / *_index.json / EU-*.yaml 等
# 仍保留在版本控制（autocrlf 噪音归 git 处理），因为它们历史上是
# 仓库的一部分；如需彻底解耦再单独走 git rm --cached 流程。
data/regulation_supplements/.cache.db
data/regulation_supplements/auto-*/
data/regulation_supplements/watchdog-*/

# Raw regulation source files (PDF/RDF/XHTML). Build pipeline reads from
# the curated data/regulations/ YAML library; the raw supplements are
# cache material that the watchdog ingests at deploy time, NOT source.
data/regulation_supplements/*/raw/
data/regulation_supplements/*.cache.db
data/regulation_supplements/auto-*/
data/regulation_supplements/watchdog-*/

# attrax-docs 目录导入的法规原件副本（PDF/HTML，共 68 份约 46MB）。YAML 条目用
# doc_files 记录来源，原件本身不入库；删掉后重跑
# `python3 scripts/import_regulation_docs.py --copy-docs` 即可恢复（YAML 已存在也
# 会补齐原件）。
data/regulations/*/raw/
# Human-readable indexes / reports stay tracked.
!data/regulation_supplements/*/DOCUMENTS.md
!data/regulation_supplements/*/README.md
!data/regulation_supplements/*.md

# NOTE: public/fonts/NotoSansSC-Regular.ttf (17MB) STAYS TRACKED — the PDF
# export modules fetch it at runtime and three test files read it from disk.
# It was briefly untracked (189885a) but adversarial review showed CI and
# fresh clones break without it; a fetch script reintroduced format risk
# (OTTO vs TrueType). Reverted in favor of keeping the asset in git.
backups/
logs/
tools/pwtest

# ─── Python ──────────────────────────────────────────────────
# bare `.venv` (no trailing slash) also matches symlinked venvs in worktrees
.venv
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─── Server-side runtime secrets (apply-deploy.sh writes these) ──
# .build-sha = current deploy commit (8-hex, 600 root)
# .rag-internal-secret = 48-hex BFF↔RAG auth (600 root)
# 真值单一来源是 /opt/attrax/{.build-sha,.rag-internal-secret}，不入库
.build-sha
.rag-internal-secret

# ─── Docker ──────────────────────────────────────────────────
qdrant_storage/

# ─── Embedding cache ─────────────────────────────────────────
*.cache/
embedding_cache/

# ─── Local Claude/worktree artifacts ─────────────────────────
.claude/
# playwright MCP 临时文件（每次 browser_navigate/screenshot 都会生成）
.playwright-mcp/

# ─── AppleDouble / Finder metadata ────────────────────────────
.DS_Store

# ─── Regression screenshots ────────────────────────────────────
# Tracked: only the baseline reference PNGs + _check.mjs / _verify.mjs /
# _verify_tabs.mjs at the .screenshots/ root.
# Untracked: every regression run dumps 100+ full-page PNGs (~337 MB per
# case, never commit them — see scripts/run-production-regression.ts).
.screenshots/regression-*/
.screenshots/online-audit-*/
/.deploy-staging/

# ─── Judge / external test packages ────────────────────────────
# 第三方评测/法官测试包（中文文件名，本地解压后留在仓外）— 仅供
# scripts/run-production-regression.ts 读取，不应纳入版本控制。
tests/fixtures/regression-package-*/
tests/fixtures/*.zip
规航AI-三产品完整测试包-20260914/
规航AI-三产品完整测试包-20260914.zip

