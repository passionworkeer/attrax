!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
test-results/
.pytest_cache/

# next.js
/.next/
/out/

# local-only E2E / work artifacts (spec §7.7 live-LLM probe dumps)
/work/
/tmp/
/output/
/outputs/

# production
/build
/dist/

