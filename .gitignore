# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
test-results/
.pytest_cache/

# next.js
/.next/
/out/

# local-only E2E / work artifacts (spec §7.7 live-LLM probe dumps)
/work/

# production
/build
/dist/

# ─── 临时文件 ──────────────────────────────────────────────────
npm.log
npm-debug.log*
test_scan.json
lib/i18n-server.ts
docs/competitions/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.production.example
.env.local

# vercel
.vercel

# runtime uploads
public/uploads/

# session persistence files (auto-generated at runtime)
data/sessions/
data/backend/

# per-session upload archive (admin-only, auto-generated, see lib/pipeline/upload-storage.ts)
data/uploads/

# user activity log (auto-generated per request)
logs/user-activity.log

# test artifacts
test-doc-upload/

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── 合规语料库 ────────────────────────────────────────────────
# 源文件（PDF/DOCX/HTML）不纳入版本控制
data/全部法规/
data/合规/
data/corpus/eu/regulations/pdfs/
data/corpus/eu/regulations/html/
data/corpus/eu/products/
data/corpus/eu/uk/
data/corpus/us/
data/corpus/cn/
data/corpus/asia/
data/corpus/middle_east/
data/corpus/gcc/
data/corpus/intl/
data/corpus/reference/
data/corpus/screenshot_pending/

# processed JSON 由 build_corpus.py 生成，不纳入版本控制；
# Official supplement ingestions are curated corpus additions and may be reviewed.
data/corpus/processed/*
!data/corpus/processed/*_Official_*.json
data/corpus/manifest.json
data/corpus/corpus_index.json
data/corpus/quality_report.json

# analysis/ 是生成产物，不纳入版本控制
data/analysis/

# Faiss 索引（由 build_faiss.py 生成，存储于 ASCII 路径）
data/faiss/
data/faiss_versions/
C:/temp/faiss_index/

# 临时输出文件
integration_result.txt
check_result.txt
/export-*.zip

# scripts/ 调试脚本（不纳入版本控制）
scripts/debug_dense.py
scripts/test_retrieval_only.py

# 归档脚本（不纳入版本控制）
scripts/archive/

# deepeval 评估产物（不纳入版本控制）
.deepeval/

# RAG eval 运行产物（评测结果 JSON，由 run_eval.py 生成）
rag_service/eval/results/

# ─── regwatch/watchdog runtime outputs (PM2 cron writes) ────────
# 这些是 regwatch 守护进程（PM2 module）在 cron 周期写入的运行时
# 产物，不应纳入版本控制。注：data/corpus/ 与 data/regulations/ 下
# watchdog 会改写的 manifest / index / *_index.json / EU-*.yaml 等
# 仍保留在版本控制（autocrlf 噪音归 git 处理），因为它们历史上是
# 仓库的一部分；如需彻底解耦再单独走 git rm --cached 流程。
data/regulation_supplements/.cache.db
data/regulation_supplements/auto-*/
data/regulation_supplements/watchdog-*/

# Raw regulation source files (PDF/RDF/XHTML). Build pipeline reads from
# the curated data/regulations/ YAML library; the raw supplements are
# cache material that the watchdog ingests at deploy time, NOT source.
data/regulation_supplements/*/raw/
data/regulation_supplements/*.cache.db
data/regulation_supplements/auto-*/
data/regulation_supplements/watchdog-*/
# Human-readable indexes / reports stay tracked.
!data/regulation_supplements/*/DOCUMENTS.md
!data/regulation_supplements/*/README.md
!data/regulation_supplements/*.md

# Large fonts are runtime assets, not source.
public/fonts/*.ttf
backups/
logs/
tools/pwtest

# ─── Python ──────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ─── Docker ──────────────────────────────────────────────────
qdrant_storage/

# ─── Embedding cache ─────────────────────────────────────────
*.cache/
embedding_cache/

# ─── Local Claude/worktree artifacts ─────────────────────────
.claude/
# playwright MCP 临时文件（每次 browser_navigate/screenshot 都会生成）
.playwright-mcp/

# ─── Nested local repository copy ────────────────────────────
attrax/
