# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
.env.local

# vercel
.vercel

# runtime uploads
public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── 合规语料库 ────────────────────────────────────────────────
# corpus/ 下的二进制法规文件不纳入版本控制，只保留元数据
data/corpus/**/*.pdf
data/corpus/**/*.docx
data/corpus/**/*.doc
data/corpus/**/processed/
data/corpus/**/screenshot_pending/
data/corpus/**/reference/

# analysis/ 是生成产物，不纳入版本控制
data/analysis/

# 临时输出文件
*.txt
integration_result.txt
check_result.txt

# scripts/ 中的一次性调试脚本（骨架工具保留）
scripts/deep_check.py
scripts/final_verify.py
scripts/full_check.py
scripts/fix_analysis_rest.py
scripts/fix_document_analysis.py