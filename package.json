{
  "name": "attrax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/guard-no-server-build.mjs",
    "build": "next build",
    "start": "next start",
    "deploy:check": "node scripts/preflight-deploy.mjs --check-only",
    "deploy:prod": "node scripts/preflight-deploy.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:pressure": "node tests/pressure/improved-load-test.js smoke",
    "test:pressure:load": "node tests/pressure/improved-load-test.js load",
    "test:rag": "node scripts/run-pytest.mjs",
    "test:all": "npm run test && npm run test:e2e && npm run test:rag",
    "codegen:openapi": "node scripts/capture-openapi.mjs",
    "codegen:rag-types": "openapi-typescript lib/rag-client/openapi.snapshot.json -o lib/rag-client/types.gen.ts",
    "codegen": "npm run codegen:openapi && npm run codegen:rag-types",
    "check:rag-contract": "npm run codegen:rag-types && git diff --exit-code lib/rag-client/types.gen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.9.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.59.1",
    "pm2": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "js-yaml": "^4.3.1",
    "ws": "^8.18.0"
  }
}
