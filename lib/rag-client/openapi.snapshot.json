  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe — returns basic status. Used by /api/health on the frontend.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "description": "Readiness probe — checks all critical dependencies.\nUsed by Kubernetes / load-balancer to decide whether to route traffic here.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/scan": {
      "post": {
        "summary": "Scan",
        "operationId": "scan_scan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
