    "/profit-report": {
      "post": {
        "summary": "Profit Report",
        "description": "生成合规成本与利润分析报告。\n\n接收产品类型和市场，从语料库检索相关文档，生成带完整成本表格的 markdown 报告。\n充电宝和乒乓球拍使用预置数据（无需 LLM 调用），其他产品尝试 LLM 填充。",
        "operationId": "profit_report_profit_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfitReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfitReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
