# Copy to .env on the server. Never commit the populated file.

WEB_PORT=3000
RAG_PORT=8001
ENV=production
DEMO_MODE=false

# Immutable source identifier injected by CI/release automation.
ATTRAX_BUILD_SHA=replace_with_git_commit_sha

# LLM provider.
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
MINIMAX_MODEL=MiniMax-M3

# Cloud embedding provider.
MODELSCOPE_API_KEY=your_modelscope_api_key

# Generate independently, for example: openssl rand -base64 48
# Set the exact same value on web and rag-service. Minimum 32 characters.
RAG_INTERNAL_SECRET=replace_with_a_strong_random_service_secret

# Explicit comma-separated browser origins; wildcard is forbidden.
RAG_ALLOWED_ORIGINS=https://your-production-domain.example

FAISS_INDEX_DIR=/app/data/faiss
ATTRAX_RUNTIME_DIR=/app/data/backend
RATE_LIMIT_STORE_DIR=/app/data/rate-limit
RATE_LIMIT_TRUST_XFF=true

# Optional tuning. The public API accepts at most five markets per scan.
SCAN_WORKER_CONCURRENCY=5

# ── Regulation watchdog (Feature 3, 2026-09-12) ────────────────────────────
# Single-pass process driven by pm2 cron_restart (scripts/ecosystem.config.cjs
# → "regwatch"). Stdlib-only; no extra pip packages required.
ATTRAX_REGWATCH_ENABLED=true
# pm2 cron expression (server local time). Override before `pm2 start` if
# you want a different cadence: ATTRAX_REGWATCH_CRON="0 4 * * *" pm2 start …
ATTRAX_REGWATCH_CRON=0 3 * * *
# Comma-separated: log (always on), slack, webhook
ATTRAX_REGWATCH_NOTIFY=log
# Required when notify includes "slack"
SLACK_WEBHOOK_URL=
# Required when notify includes "webhook" — receives the full JSON report
ATTRAX_REGWATCH_WEBHOOK=
