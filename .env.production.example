# Copy this file to .env on the server before running docker compose.

WEB_PORT=3000
RAG_PORT=8001

DEMO_MODE=false

# LLM API Key (MiniMax-M3 via Anthropic-compatible endpoint)
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
MINIMAX_MODEL=MiniMax-M3

# Required cloud embedding API.
MODELSCOPE_API_KEY=your_modelscope_api_key

# Comma-separated browser origins allowed to call rag-service directly.
# Add your public origin after reverse proxy setup, for example:
# RAG_ALLOWED_ORIGINS=https://attrax.example.com
RAG_ALLOWED_ORIGINS=http://localhost:3000

# Persistent scan state inside the rag-service container. docker-compose.yml
# mounts ./data/backend at this location.
ATTRAX_RUNTIME_DIR=/app/data/backend
