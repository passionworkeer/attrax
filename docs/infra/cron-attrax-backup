# /etc/cron.d/attrax-backup — daily local data backup.
#
# Install:
#   sudo cp docs/infra/cron-attrax-backup /etc/cron.d/attrax-backup
#   sudo chown root:root /etc/cron.d/attrax-backup
#   sudo chmod 644 /etc/cron.d/attrax-backup
#
# Script source of truth: scripts/backup-data.sh in this repo (deployed to
# /opt/attrax/scripts/backup-data.sh). The two must stay in sync — see the
# guard in tests/unit/infra-cron-references.test.ts.
#
# Runs as `root`: on the current aliyun-sz (2026-09-18 lighthouse → aliyun-sz
# runtime migration) pm2 itself runs as root and the only regular user is
# `admin`. An earlier revision said `ubuntu` — a user that has never existed
# on this host, so the 3am backup silently never ran (2026-09-18 audit).
#
# A cron.d file accepts only comments, KEY=VALUE environment lines and job
# lines. Stray banner text here is a hard error for cron, so keep it clean —
# this fragment previously carried a four-line `*****` banner that would have
# been rejected on install.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * * root /opt/attrax/scripts/backup-data.sh >> /opt/attrax/logs/attrax-backup.log 2>&1
