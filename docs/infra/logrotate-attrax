# /etc/logrotate.d/attrax — logs that grow on the attrax host.
#
# Install:
#   sudo cp docs/infra/logrotate-attrax /etc/logrotate.d/attrax
#   sudo logrotate -d /etc/logrotate.conf     # dry run; must print no error
#
# Why this file exists: neither /opt/attrax/logs/ nor the pm2 logs nor
# data/backend/audit.jsonl was covered by any logrotate fragment, so they only
# ever grew. audit.jsonl in particular is append-only in the application
# (FileBackend._append_audit), which makes this rotation its only bound.
#
# The global /etc/logrotate.conf sets `su root adm`. Blocks that touch
# app-owned files restate `su root root` so rotation works from the
# app's own ownership rather than relying on root's ability to write there.
# aliyun-sz deployment runs as root (the previous `su ubuntu ubuntu`
# referenced the retired lighthouse host where pm2 was installed under
# a dedicated `pm2-ubuntu` service user; cron then silently skipped these
# jobs — see CHANGELOG 2026-09-18 batch).
#
# Deliberately NOT covered here (other owners):
#   - /var/log/nginx/*.log, including monitor-events.log -> the distro
#     fragment /etc/logrotate.d/nginx.
#   - /home/ubuntu/.pm2/logs/*.log -> the pm2-logrotate module already does
#     this (max_size 50M, retain 10, compress, rotateInterval 0 0 * * *).
#     Two rotators on the same files race and produce a mix of pm2's
#     `__YYYY-MM-DD_HH-mm-ss` names and logrotate's `.1`/`.gz` names, so this
#     fragment must stay out of that directory.
#   - the monitor/uptime stack -> versioned in the work repo at ops/monitor/.

# Cron-redirected backup logs: each run appends with >>, so no process holds
# the descriptor open and a plain create is correct.
/opt/attrax/logs/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
    su root root
}

# Append-only JSONL audit trail (session ids, evidence/revision decisions).
# Weekly rather than daily because each entry matters for post-hoc review and
# rotating too eagerly makes the trail awkward to read. copytruncate because
# FileBackend holds the descriptor open: truncating in place preserves the
# inode, hence the file's 0600 mode and ownership, so no create directive is
# used.
/opt/attrax/data/backend/audit.jsonl {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
}
