limit_req_zone $binary_remote_addr zone=attrax_api:10m rate=10r/s;

upstream attrax_nextjs {
    server 127.0.0.1:__NEXTJS_PORT__ max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name twinbuddy.xyz www.twinbuddy.xyz 203.0.113.10 example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name twinbuddy.xyz www.twinbuddy.xyz 203.0.113.10;

    ssl_certificate     /etc/letsencrypt/live/twinbuddy.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/twinbuddy.xyz/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 50m;
    client_body_timeout  300s;

    # Per-IP concurrent connection cap. Pairs with limit_req (per-IP rate
    # cap at the location level) to bound total sockets a single client can
    # hold open. 20 is enough for a real user with long-poll + upload + a
    # few tabs of asset/report fetches, and well below worker_connections/2
    # so a single client can't saturate the worker pool.
    limit_conn attrax_conn 20;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header X-DNS-Prefetch-Control "off" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;

    location ~ /\.(env|env\.local|env\.production|git|svn|htaccess|htpasswd|gitignore|DS_Store) {
        return 404;
    }
    location ~* \.(yml|yaml|conf|cnf|ini|env\.bak|env\.sample|env\.example)(\.|$) {
        return 444;
    }
    location ~* ^/(wp-admin|wp-login|wp-content|wp-includes|administrator|xmlrpc\.php|phpmyadmin|\.well-known/security\.txt) {
        return 404;
    }
    location ~* \.(sql|bak|backup|old|orig|swp|sql\.gz|tar\.gz|zip|log)$ {
        return 404;
    }

    location ^~ /_next/static/ {
        alias /opt/attrax/.next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ^~ /_next/data/ {
        alias /opt/attrax/.next/static/;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    location ~ ^/complipilot/.+\.(png|webp|mp4)$ {
        root /opt/attrax/.next/standalone/public;
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    location = /api/health {
        proxy_pass http://attrax_nextjs;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/scan(/.*)?$ {
        limit_req zone=attrax_api burst=20 nodelay;
        limit_req_status 429;
        # H8 hardening: retry transient upstream failures. We currently have
        # a single upstream (attrax_nextjs); with one server proxy_next_upstream
        # is a no-op because there is no second target. Setting it anyway is
        # intentional and future-proof: adding a second backend instance
        # (e.g. blue/green or pm2 cluster) makes the retry policy take effect
        # without a config change. max_fails/fail_timeout on the upstream
        # server line (M9) marks an upstream down after 3 failures in 30s,
        # so retries to a flapping instance are bounded.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_pass http://attrax_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        limit_req zone=attrax_api burst=40 nodelay;
        limit_req_status 429;
        # See /api/scan for the rationale: single-upstream means retries are
        # no-ops today, but the directive is set so adding a second backend
        # does not require a vhost change.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_pass http://attrax_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}